{
  "name": "@nmmty/lazycanvas",
  "version": "1.0.1",
  "description": "Declarative 2D canvas rendering with flexbox layout, JSX and signal-based animation — for Node.js and the browser.",
  "keywords": [
    "canvas",
    "2d",
    "jsx",
    "layout",
    "flexbox",
    "yoga",
    "animation",
    "signals",
    "image-generation",
    "napi-rs",
    "browser",
    "node"
  ],
  "homepage": "https://github.com/NMMTY/LazyCanvas/tree/main/packages/lazycanvas#readme",
  "bugs": {
    "url": "https://github.com/NMMTY/LazyCanvas/issues"
  },
  "license": "MIT",
  "author": "NMMTY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NMMTY/LazyCanvas.git",
    "directory": "packages/lazycanvas"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./fonts": {
      "import": {
        "types": "./dist/fonts/index.d.mts",
        "default": "./dist/fonts/index.mjs"
      },
      "require": {
        "types": "./dist/fonts/index.d.ts",
        "default": "./dist/fonts/index.js"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/jsx-runtime.d.mts",
        "default": "./dist/jsx-runtime.mjs"
      },
      "require": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/jsx-dev-runtime.d.mts",
        "default": "./dist/jsx-dev-runtime.mjs"
      },
      "require": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx-dev-runtime.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": ["./dist/node/index.d.ts"],
      "fonts": ["./dist/fonts/index.d.ts"],
      "jsx-runtime": ["./dist/jsx-runtime.d.ts"],
      "jsx-dev-runtime": ["./dist/jsx-dev-runtime.d.ts"]
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "font": "tsx ./scripts/font-gen.ts",
    "docgen": "tsx docgen.ts && tsx ./scripts/post-docgen.ts"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hitomihiumi/colors.ts": "^1.0.3",
    "@hitomihiumi/micro-docgen": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsup": "8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
