{
  "name": "@nmmty/lazycanvas",
  "version": "1.0.0-dev.10",
  "description": "A simple way to interact with canvas in an advanced way!",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "docgen": "tsx docgen.ts && tsx ./scripts/post-docgen.ts",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "font": "tsx ./scripts/font-gen.ts",
    "build": "tsc && tsx ./scripts/post-build.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NMMTY/LazyCanvas.git"
  },
  "keywords": [
    "canvas",
    "node-canvas",
    "browser-canvas",
    "easy",
    "simple",
    "jsx"
  ],
  "author": "NMMTY",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NMMTY/LazyCanvas/issues"
  },
  "homepage": "https://github.com/NMMTY/LazyCanvas#readme",
  "dependencies": {
    "gifenc": "^1.0.3",
    "js-yaml": "^4.1.0",
    "svgson": "^5.3.1",
    "yoga-layout": "^3.2.1"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.88"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hitomihiumi/colors.ts": "^1.0.3",
    "@hitomihiumi/micro-docgen": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
