{
  "name": "@nmmty/adapter-react",
  "version": "1.0.0-dev.1",
  "description": "React integration for @nmmty/lazycanvas — <Scene> component with browser adapter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
